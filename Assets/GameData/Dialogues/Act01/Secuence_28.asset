  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: "Creo que s\xED quiero que me ayudes."
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: "No s\xE9 si voy a poder cambiar todo sola."
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 672b8572fb27e4d43a55a4782920e11f, type: 2}
    spriteId: 
    characterPosition: 1
    characterVisible: 1
    text: No tienes que hacerlo sola.
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: "Gracias.\nCreo que tambi\xE9n deber\xEDa hablar con alguien que pueda
      orientarme mejor."
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 672b8572fb27e4d43a55a4782920e11f, type: 2}
    spriteId: 
    characterPosition: 1
    characterVisible: 1
    text: "Si quieres, puedo acompa\xF1arte."
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: "S\xED. Creo que ser\xEDa m\xE1s f\xE1cil si no tengo que hacerlo sola."
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
