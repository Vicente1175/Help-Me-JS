--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8ce34627539063d42b9e0eeb6cf9cb89, type: 3}
  m_Name: Secuence_27
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequenceSO
  lines:
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 0
    text: (Sales de casa y vas en camino al instituto)
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: Hoy tengo que intentar hacerlo diferente.
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: "No s\xE9 si voy a conseguir cambiar todo de una vez..."
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: "Pero s\xED puedo seguir intentando."
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: Tal vez eso sea lo importante.
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: No hacerlo perfecto.
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: "Solo seguir intent\xE1ndolo."
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 0
    text: (Llegas al instituto y comienzan las clases)
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 67b0d18a9dbe794428f9fdf6076e323f, type: 2}
    spriteId: 
    characterPosition: 1
    characterVisible: 1
    text: "Recuerden que para la pr\xF3xima clase deben terminar el ejercicio que
      estamos trabajando."
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: "Esta vez s\xED quiero intentar poner atenci\xF3n."
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 0
    text: (Comienza a tomar a apunter)
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: "Todav\xEDa tengo sue\xF1o...\nPero puedo concentrarme un poco m\xE1s."
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: "No necesito que todo cambie de un d\xEDa para otro.\nSolo necesito seguir
      cuid\xE1ndome."
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 0
    text: (Suena el timbre del recreo)
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 672b8572fb27e4d43a55a4782920e11f, type: 2}
    spriteId: 
    characterPosition: 1
    characterVisible: 1
    text: "Hola. \xBFC\xF3mo est\xE1s hoy?"
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: Un poco cansada.
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 672b8572fb27e4d43a55a4782920e11f, type: 2}
    spriteId: 
    characterPosition: 1
    characterVisible: 1
    text: "\xBFY c\xF3mo te fue anoche?"
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: No fue perfecto.
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: Pero estoy intentando cambiar algunas cosas.
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 672b8572fb27e4d43a55a4782920e11f, type: 2}
    spriteId: 
    characterPosition: 1
    characterVisible: 1
    text: Eso ya es algo.
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: "S\xED. Creo que antes pensaba que ten\xEDa que cambiar todo de una vez."
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: "Y si no pod\xEDa, simplemente volv\xEDa a hacer lo mismo."
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 672b8572fb27e4d43a55a4782920e11f, type: 2}
    spriteId: 
    characterPosition: 1
    characterVisible: 1
    text: "No tienes que hacerlo as\xED."
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: Supongo que estoy empezando a entenderlo...
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 672b8572fb27e4d43a55a4782920e11f, type: 2}
    spriteId: 
    characterPosition: 1
    characterVisible: 1
    text: Puedes hablar conmigo cuando quieras.
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
