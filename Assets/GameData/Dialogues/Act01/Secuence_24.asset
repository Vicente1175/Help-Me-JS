  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8ce34627539063d42b9e0eeb6cf9cb89, type: 3}
  m_Name: Secuence_24
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequenceSO
  lines:
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 0
    text: "(Llega la noche y entras a tu habitaci\xF3n)"
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: 'Estoy agotada.

      Solo quiero acostarme.'
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 0
    text: (Mira el celular sobre la cama.)
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: "Podr\xEDa ver unos videos para distraerme..."
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 0
    text: (Se queda mirando a la pantalla)
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: No...
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: Eso fue exactamente lo que dije ayer.
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: Y antes de ayer.
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: "Y termin\xE9 despierta hasta las cuatro y media."
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 0
    text: (Deja el celular sobre el escritorio.)
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: Hoy voy a intentar hacerlo diferente.
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: "(Prepara el uniforme y la mochila para el d\xEDa siguiente.)"
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: "As\xED ma\xF1ana no tengo que hacerlo con sue\xF1o."
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: "Creo que tambi\xE9n deber\xEDa poner una alarma y dejar el celular lejos
      de la cama."
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: "No s\xE9 si voy a conseguir dormirme r\xE1pido."
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: Pero al menos estoy intentando.
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
