  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: "\xBFQu\xE9 estaba haciendo?"
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: Ni siquiera estaba mirando.
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: "Si hubiera dormido bien... no estaria as\xED."
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: Todo por quedarme viendo videos.
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: "S\xE9 perfectamente lo que deber\xEDa hacer, pero cuando llega el momento
      termino haciendo lo mismo otra vez."
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: "Tengo que mejorar mi horario de sue\xF1o"
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
