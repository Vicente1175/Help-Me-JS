  lines:
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: "A ver... \xBFqu\xE9 me perd\xED mientras estaba dormida?"
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 67b0d18a9dbe794428f9fdf6076e323f, type: 2}
    spriteId: 
    characterPosition: 1
    characterVisible: 1
    text: "\xBFTodav\xEDa con el celular? Acabas de decir que estabas cansada."
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: Solo estoy revisando las notificaciones. No voy a quedarme mucho tiempo.
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 67b0d18a9dbe794428f9fdf6076e323f, type: 2}
    spriteId: 
    characterPosition: 1
    characterVisible: 1
    text: Eso mismo dijiste anoche.
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: "S\xED, pero ahora s\xED es solo un momento."
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 67b0d18a9dbe794428f9fdf6076e323f, type: 2}
    spriteId: 
    characterPosition: 1
    characterVisible: 1
    text: Bueno, pero desayuna primero.
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: "S\xED, s\xED. Solo uno m\xE1s."
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: Uy...
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: Ya son las 5:31.
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
  - character: {fileID: 11400000, guid: 61f72e4213c52644380017b7699e7e8e, type: 2}
    spriteId: 
    characterPosition: 0
    characterVisible: 1
    text: "Tengo que comer r\xE1pido."
    backgroundId: 
    soundId: 
    musicId: 
    eventId: 
